# Normalize line endings: text files are stored as LF, checked out per platform.
* text=auto

*.cs text diff=csharp
*.csproj text
*.slnx text
*.props text
*.json text
*.md text
*.yml text
*.ts text
*.tsx text
*.css text
*.html text
*.sh text eol=lf
*.lua text eol=lf
# copied byte for byte into new projects and written the way the app writes road edits (LF)
data/road-edits-default.json text eol=lf

*.png binary
*.ico binary
*.exe binary
*.ytd binary
*.ydd binary
*.gfx binary

# the style editor sample land (generated by the developer tools; binary grid)
data/sample-island/*.grid binary
data/sample-island/*.json text eol=lf

# Extra Map Tiles 3.0.1, bundled as in its release zip (byte for byte)
data/minimap/extra-map-tiles/** -text
